# Copy file này thành .env rồi điền giá trị.

# Khoá OpenRouter, lấy tại openrouter.ai
OPENROUTER_API_KEY=

# Model trên OpenRouter có hỗ trợ structured outputs
QUIZ_MODEL=

# mock = bộ câu hỏi cố định, không gọi mạng, không tốn tiền
# llm  = gọi model thật
QUESTIONS_SOURCE=mock

# Địa chỉ để mã QR trỏ tới. Chạy trên máy: http://<IP máy bạn>:8000
# Để trống thì dùng địa chỉ của request.
PUBLIC_BASE_URL=
